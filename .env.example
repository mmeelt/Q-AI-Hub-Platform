# Optional overrides for "docker compose up" (copy to .env). Every value has a local default.
# For running the API without Docker, use backend/.env.example instead.

DB_PASSWORD=qaihub-local
# 64+ random characters (openssl rand -base64 64). Empty = a temporary one per container start.
JWT_SECRET=

# Demo accounts created on a brand-new database: qaihubb@gmail.com and test@mail.com
SEED_ADMIN_PASSWORD=Admin#Demo2026
SEED_USER_PASSWORD=User#Demo2026

# Login codes are emailed through this SMTP account (Gmail: an App Password from
# https://myaccount.google.com/apppasswords). backend/.env is read too, so the account set
# there for local runs also works here. With no account, every login code is OTP_FIXED_CODE.
OTP_FIXED_CODE=123456
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=

# Optional AI features
GEMINI_API_KEY=

# Host ports (change them if 8080 / 8081 are already used on your machine)
WEB_PORT=8080
API_PORT=8081
