# Optional overrides for "docker compose up" (copy to .env). Every value has a local default.
# For running the API without Docker, use backend/.env.example instead.

DB_PASSWORD=qaihub-local
# 64+ random characters (openssl rand -base64 64). Empty = a temporary one per container start.
JWT_SECRET=

# Demo accounts created on a brand-new database: admin@platform.com and test@mail.com
SEED_ADMIN_PASSWORD=Admin#Demo2026
SEED_USER_PASSWORD=User#Demo2026

# Login codes: fixed code by default. To receive real codes by email set OTP_FIXED_ENABLED=false
# and fill in the MAIL_* values.
OTP_FIXED_ENABLED=true
OTP_FIXED_CODE=123456
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=

# Optional AI features
GEMINI_API_KEY=

# Host ports (change them if 8080 / 8081 are already used on your machine)
WEB_PORT=8080
API_PORT=8081
