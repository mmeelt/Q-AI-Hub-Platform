# Q-AI Hub API - local secrets.
# Copy this file to backend/.env (gitignored - never commit it) and fill in your values.
# Spring loads it via spring.config.import when the API is started from the backend/ folder.

# --- Profile: dev (local, seeds test data) | prod (real deployment) ---
SPRING_PROFILES_ACTIVE=dev

# --- Database (MySQL) ---
DB_URL=jdbc:mysql://localhost:3306/qaihub?createDatabaseIfNotExist=true&serverTimezone=UTC&allowPublicKeyRetrieval=true&useSSL=false
DB_USERNAME=root
DB_PASSWORD=

# --- JWT signing key: required in prod, at least 64 random characters ---
# Generate one with:  openssl rand -base64 64
JWT_SECRET=

# --- Frontend URL: CORS + links in emails (comma-separate several origins in CORS_ALLOWED_ORIGINS) ---
FRONTEND_URL=http://localhost:5173

# --- Google Gemini ---
# optional: AI feedback features (https://aistudio.google.com/apikey)
GEMINI_API_KEY=

# --- SMTP used to send OTP codes and notifications to real inboxes ---
# Gmail: enable 2-Step Verification, then create an App Password at
# https://myaccount.google.com/apppasswords and paste it (16 chars, no spaces) below.
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
# usually the same address as MAIL_USERNAME
MAIL_FROM=

# --- Admin account (dev profile, brand-new database only) ---
# qaihubb@gmail.com gets this password. Leave empty to get a random one in the log.
SEED_ADMIN_PASSWORD=
